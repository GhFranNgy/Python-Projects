import csv
import json
import os
import sys
from datetime import datetime

library_path = os.path.join(os.path.dirname(__file__), "library.json")
export_path = os.path.join(os.path.dirname(__file__), "export.csv")
reading_log = os.path.join(os.path.dirname(__file__), "reading_log.txt")

library = []

def load_library(library):
    print("Load Library...")
    try:
        with open(library_path, "r") as f:
            library = json.load(f)
    except FileNotFoundError:
        print(f"Error: {library_path} nicht gefunden.")
        sys.exit()
    except json.JSONDecodeError:
        print("Missing or damaged file.")
        sys.exit()

    with open(reading_log, "a") as f:
        f.write(f"{datetime.now()}: Library loaded\n")
        
    return library

def save_library(library):
    print("Save Library...")
    with open(library_path, "w") as f:
        json.dump(library, f, indent=2)

    with open(reading_log, "a") as f:
        f.write(f"{datetime.now()}: Library saved\n")

def get_next_id(library):
    if not library:
        return 1
    return max(book["id"] for book in library) + 1 # pulls out largest ID and adds 1

def add_book(library, title, author, pages, status):
    for book in library:
        if book["title"] == title and book["author"] == author:
            print("Book already exists in library.")
            break
    else:
        try:
            pages = int(pages)
        except ValueError:
            print("Pages must be a whole number.")
            return

        book = {
            "id": get_next_id(library),
            "title": title,
            "author": author,
            "pages": pages,
            "status": status
        }
        library.append(book)
        save_library(library)
        print(f"Book '{title}' by {author} added to library.")

        with open(reading_log, "a") as f:
            f.write(f"{datetime.now()}: Added '{title}' by {author}\n")

def update_status(library, title):
    for book in library:
        if title == book["title"]:
            check_author = input(f"{title} by {book["author"]}? y/N\n")
            if check_author.lower() == "y":
                try:
                    status_id = input("(1) Reading\n(2) Finished\n(3) Not Started\nSelect new status: ")
                    if status_id == "1":
                        status = "Reading"
                    elif status_id == "2":
                        status = "Finished"
                    elif status_id == "3":
                        status = "Not Started"
                    else:
                        print("Invalid selection.")
                        return
                except ValueError:
                    print("Please enter a whole number.")
                    return
                book["status"] = status
                with open(reading_log, "a") as f:
                    f.write(f"{datetime.now()}: Updated status of '{title}' to '{status}'\n")
            elif check_author.lower() == "n":
                print("Wrong Book. Exiting...")
            else:
                print("Selection not valid")
            break
    else:
        print("Book not found.")

def remove_book(library, title):
    matches = [book for book in library if book["title"] == title]

    if not matches:
        print("Book not found")
        return

    for book in matches:
        print(book)

    check_book = input("Is correct book shown? y/N\n")
    if check_book.lower() == "y":
        try:
            book_id = int(input("Select Book ID to delete: "))
        except ValueError:
            print("ID must be a whole number")
            return
    elif check_book.lower() == "n":
        print("Wrong book. Exiting...")
        return
    else:
        print("Selection not valid")
        return

    for book in library:
        if book_id == book["id"]:
            confirm = input(f"Type the title to confirm deletion of '{book['title']}': ")
            if confirm == book["title"]:
                library.remove(book)
                save_library(library)
                with open(reading_log, "a") as f:
                    f.write(f"{datetime.now()}: Removed '{book['title']}'\n")
                print(f"Removed '{book['title']}'.")
            else:
                print("Title didn't match, deletion cancelled.")
            return

    print("No book found with that ID.")
    
def search_book(library, title):
    matches = [book for book in library if book["title"] == title]
    print(f"Found {len(matches)} matches for '{title}':")
    for book in matches:
        print(book)
    with open(reading_log, "a") as f:
        f.write(f"{datetime.now()}: Searched for '{title}'\n")

def show_stats(library):
    reading = 0
    finished = 0
    not_started = 0

    total_books = len(library)
    total_pages = sum(book["pages"] for book in library)
    print(f"Total books: {total_books}")
    print(f"Total pages: {total_pages}")

    for book in library:
        if book["status"].lower() == "reading":
            reading += 1
        elif book["status"].lower() == "finished":
            finished += 1
        elif book["status"].lower() == "not started":
            not_started += 1
    print(f"Books in progress: {reading}")
    print(f"Finished books: {finished}")
    print(f"Books not started: {not_started}")

    for book in library:
        print(f"{book['title']} by {book['author']}, {book['pages']} pages, Status: {book['status']}")

    with open(reading_log, "a") as f:
        f.write(f"{datetime.now()}: Showed stats\n")

def export_csv(library):
    if not library:
        print("Library is empty. No data to export.")
        return

    sorted_books = sorted(library, key=lambda book: book["pages"], reverse=True)

    with open(export_path, "w", newline="") as csvfile:
        fieldnames = ["id", "title", "author", "pages", "status"]
        writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(sorted_books)

    print(f"Exported {len(sorted_books)} books to {export_path}.")

def handle_selection(selection):

    if selection == 1:
        print("-----Add Book-----")
        title = input("Title: ")
        author = input("Author: ")
        pages = input("Pages: ")

        add_book(library, title, author, pages, "Not Started")

    elif selection == 2:
        print("-----Update Status-----")
        title = input("Title: ")

        update_status(library, title)

    elif selection == 3:
        print("-----Remove Book-----")
        title = input("Title: ")

        remove_book(library, title)

    elif selection == 4:
        print("-----Search Book-----")
        title = input("Title: ")

        search_book(library, title)

    elif selection == 5:
        print("-----Show Stats-----")
        show_stats(library)

    elif selection == 6:
        print("-----Export CSV-----")
        export_csv(library)

    elif selection == 7:
        print("-----Exit-----")
        sys.exit()

    else:
        print("Invalid selection")

# main 
library = load_library(library)
while True:
    try:
        selection = int(input("-----Select action-----\n" \
            "(1) Add Book\n" \
            "(2) Update Status\n" \
            "(3) Remove Book\n" \
            "(4) Search Book\n" \
            "(5) Show Stats\n" \
            "(6) Export CSV\n" \
            "(7) Exit\n"))

        if selection in range(1,8):
            handle_selection(selection)
        else:
            print("Please enter a number in range of 1-7")

    except(ValueError):
        print("Please enter a valid number")
